# Serenica Environment Configuration
# Copy to .env and fill in values

# ============================================================
# SERVER CONFIG
# ============================================================
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/serenica

# PostgreSQL Setup:
# 1. Create database: createdb serenica
# 2. Enable pgvector: psql serenica -c "CREATE EXTENSION IF NOT EXISTS pgvector"
# 3. Run migrations: alembic upgrade head

# ============================================================
# MACHINE LEARNING
# ============================================================

# Using Ollama (recommended for local development)
USE_OLLAMA=True
OLLAMA_MODEL=mistral
# Install Ollama from: https://ollama.ai
# Run: ollama serve
# Download model: ollama pull mistral

# Using local transformers (requires GPU for reasonable performance)
# USE_OLLAMA=False
# MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.1

# Embeddings Model
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# SAFETY & FEATURES
# ============================================================
SAFETY_ENABLED=True
CRISIS_DETECTION_ENABLED=True
RAG_ENABLED=True
RAG_TOP_K=3

# ============================================================
# AUTHENTICATION
# ============================================================
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# CORS (Frontend URLs)
# ============================================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://127.0.0.1:3000"]

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# MONITORING (Optional)
# ============================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=False

# ============================================================
# REDIS (For caching & task queue)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# CELERY (For async tasks)
# ============================================================
CELERY_BROKER=redis://localhost:6379/1
CELERY_BACKEND=redis://localhost:6379/2
